# Локальная разработка. Скопируйте в .env и заполните значения.
# docker-compose.dev.yml подхватывает этот файл автоматически.

DEBUG=True
USE_HTTPS=False
BEHIND_HTTPS_PROXY=False
TRUST_PROXY_HEADERS=False
SECRET_KEY=dev-only-change-me-to-a-long-random-string

ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# SQLite по умолчанию; для Docker Postgres см. docker-compose.dev.yml (DATABASE_URL переопределяется)
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=tehnikagoda_db
POSTGRES_USER=tehnikagoda_prod
POSTGRES_PASSWORD=change-me-local

# Required for Docker Redis. Host URLs use 127.0.0.1; compose overrides host to `redis`.
REDIS_PASSWORD=change-me-local-redis
REDIS_BROKER_URL=redis://:change-me-local-redis@127.0.0.1:6379/0
REDIS_CACHE_URL=redis://:change-me-local-redis@127.0.0.1:6379/1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Analytics: async visit logging via Celery (requires worker). False = sync writes.
ANALYTICS_ASYNC=True
ANALYTICS_RETENTION_DAYS=90
# Store raw client IP in VisitEvent (default off — privacy)
ANALYTICS_STORE_IP=False

ADMIN_URL_PREFIX=local-admin/
# Только loopback для локалки. Не копируйте Docker-диапазоны в прод.
# docker-compose.dev.yml сам добавляет 172.16.0.0/12 для доступа к админке из Docker.
ADMIN_ALLOWED_IPS=127.0.0.1,::1
# ALLOW_OPEN_ADMIN=True  # только если DEBUG=False и IP-список ещё не задан

# Не смешивайте этот файл с прод-значениями (USE_HTTPS=True, боевые пароли, tehnikagoda.ru).
# Для продакшена копируйте .env.production.example.

# Ссылки на профили с отзывами (опциональный fallback).
# Основное место: админка → «Ссылки на отзывы».
REVIEW_YANDEX_URL=
REVIEW_2GIS_URL=
REVIEW_AVITO_URL=

# Верификация вебмастеров (опционально)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# SEO landing pages (/catalog/brands/, model pages). False = hide + redirect to catalog.
SEO_MODEL_PAGES_ENABLED=True

# Яндекс.Метрика — только номер счётчика (цифры). Пусто = не подключать.
# Грузится после согласия в cookie-баннере («Принять»).
YANDEX_METRIKA_ID=
