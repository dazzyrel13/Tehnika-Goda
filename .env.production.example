# Пример переменных окружения для продакшена.
# Скопируйте в .env и заполните реальными значениями. НЕ коммитьте .env.

DEBUG=False
USE_HTTPS=True
BEHIND_HTTPS_PROXY=True
TRUST_PROXY_HEADERS=True
SECRET_KEY=change-me-to-a-long-random-string

ALLOWED_HOSTS=tehnikagoda.ru,www.tehnikagoda.ru
# 127.0.0.1/localhost are added automatically for Docker healthchecks.
SITE_URL=https://tehnikagoda.ru

DATABASE_URL=postgres://USER:PASSWORD@db:5432/tehnikagoda_db
POSTGRES_DB=tehnikagoda_db
POSTGRES_USER=tehnikagoda_prod
POSTGRES_PASSWORD=change-me

# Strong random password; URLs below must include it (no unauthenticated Redis in prod)
REDIS_PASSWORD=change-me-redis-password
REDIS_BROKER_URL=redis://:change-me-redis-password@redis:6379/0
REDIS_CACHE_URL=redis://:change-me-redis-password@redis:6379/1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CORS_ALLOWED_ORIGINS=https://tehnikagoda.ru,https://www.tehnikagoda.ru
CSRF_TRUSTED_ORIGINS=https://tehnikagoda.ru,https://www.tehnikagoda.ru

ANALYTICS_ASYNC=True
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_STORE_IP=False

ADMIN_URL_PREFIX=change-me-unique-admin-path/
# Option A — email approval (login from any IP; link sent to this inbox):
ADMIN_LOGIN_EMAIL_APPROVAL=True
ADMIN_LOGIN_APPROVAL_EMAIL=lost-devil@mail.ru
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=lost-devil@mail.ru
EMAIL_HOST_PASSWORD=change-me-mailru-app-password
DEFAULT_FROM_EMAIL=lost-devil@mail.ru
# Option B — IP allowlist instead (leave ADMIN_LOGIN_EMAIL_APPROVAL=False):
# ADMIN_ALLOWED_IPS=203.0.113.10
ALLOW_OPEN_ADMIN=False

# Copy from this file only — never reuse a local DEBUG=.env as production.

# Яндекс.Метрика (номер счётчика). Пусто = выкл.
YANDEX_METRIKA_ID=
